---
import { localePath } from "../i18n/paths.ts";

import { getCopy } from "../i18n/index.ts";
import type { Locale } from "../types.ts";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const content = getCopy(locale).consent;
---

<aside
  id="analytics-consent"
  class="analytics-consent container"
  aria-labelledby="analytics-title"
  hidden
>
  <div>
    <h2 id="analytics-title" tabindex="-1">
      {content.title}
    </h2>
    <p>{content.description}</p>
    <p>
      <a href={`${localePath(locale, "privacy")}#cookie`}>
        {content.privacyLink}
      </a>
      .
    </p>
    <p id="analytics-choice"></p>
  </div>
  <div class="analytics-actions">
    <button type="button" class="button" id="analytics-reject">
      {content.reject}
    </button>
    <button type="button" class="button" id="analytics-accept">
      {content.accept}
    </button>
  </div>
</aside>
