---
import { getCopy } from "../i18n/index.ts";
import { localeInfo, localePath, locales } from "../lib/localized.ts";
import type { Locale, PageName } from "../types.ts";

interface Props {
  locale: Locale;
  page?: PageName;
}
const { locale, page = "home" } = Astro.props;
const copy = getCopy(locale);
---

<details class="language-switcher">
  <summary>
    <span>{localeInfo[locale].code}</span>
    <span class="sr-only">{copy.common.language}</span>
  </summary>
  <ul aria-label={copy.common.languageMenu}>
    {locales.map((item) => (
      <li>
        <a
          href={localePath(item, page)}
          lang={item}
          hreflang={item}
          aria-current={item === locale ? "page" : undefined}
          data-locale-link
        >
          <span>{localeInfo[item].code}</span> {localeInfo[item].name}
        </a>
      </li>
    ))}
  </ul>
</details>

<script>
  const safeAnchors = new Set([
    "home",
    "dimora",
    "spazi",
    "ascoli",
    "soggiorno",
    "contatti",
    "richieste",
    "navigazione",
    "cookie",
    "destinatari",
    "diritti",
  ]);
  document
    .querySelectorAll<HTMLAnchorElement>("[data-locale-link]")
    .forEach((link) => {
      link.addEventListener("click", () => {
        link.hash = "";
        try {
          const anchor = decodeURIComponent(location.hash.slice(1));
          if (safeAnchors.has(anchor)) link.hash = anchor;
        } catch {
          // Invalid fragments must never prevent language navigation.
        }
      });
    });
  document
    .querySelectorAll<HTMLDetailsElement>(".language-switcher")
    .forEach((menu) => {
      const trigger = menu.querySelector("summary");
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && menu.open) {
          menu.open = false;
          if (menu.contains(document.activeElement)) trigger?.focus();
        }
      });
      document.addEventListener("click", (event) => {
        if (event.target instanceof Node && !menu.contains(event.target))
          menu.open = false;
      });
      menu.addEventListener("focusout", (event) => {
        if (
          event.relatedTarget instanceof Node &&
          !menu.contains(event.relatedTarget)
        )
          menu.open = false;
      });
    });
</script>
