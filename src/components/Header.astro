---
import { localePath } from "../i18n/paths.ts";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { getCopy } from "../i18n/index.ts";
import type { Locale, PageName } from "../types.ts";
interface Props {
  locale: Locale;
  page?: PageName;
  compact?: boolean;
}
const { locale, page = "home", compact = false } = Astro.props;
const copy = getCopy(locale);
const home = localePath(locale);
const ids = ["dimora", "spazi", "ascoli", "soggiorno"];
---

<header class="site-header">
  <a class="wordmark" href={compact ? home : "#home"}>
    ver sacrum<span>{copy.common.tagline}</span>
  </a>
  {!compact && (
    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="navigation"
      aria-label={copy.common.menuOpen}
      data-open-label={copy.common.menuOpen}
      data-close-label={copy.common.menuClose}
      hidden
    >
      {copy.common.menu} <span aria-hidden="true">☰</span>
    </button>
  )}
  {compact ? (
    <div class="header-tools">
      <a class="text-link" href={`${home}#contatti`}>
        {copy.common.request}
      </a>
      <LanguageSwitcher locale={locale} page={page} />
    </div>
  ) : (
    <div class="header-tools">
      <nav id="navigation" aria-label={copy.common.navLabel}>
        {copy.common.nav.map((label, index) => (
          <a href={`#${ids[index]}`}>{label}</a>
        ))}
        <a class="nav-cta" href="#contatti">
          {copy.common.request} <span aria-hidden="true">↗</span>
        </a>
      </nav>
      <LanguageSwitcher locale={locale} page={page} />
    </div>
  )}
</header>

{!compact && <script>
  function required<ElementType extends Element>(
    selector: string,
  ): ElementType {
    const element = document.querySelector<ElementType>(selector);
    if (!element) throw new Error(`Missing required element: ${selector}`);
    return element;
  }
  const header = required<HTMLElement>(".site-header");
  const toggle = required<HTMLButtonElement>(".menu-toggle");
  const navigation = required<HTMLElement>("#navigation");
  const mobile = matchMedia("(max-width: 899px)");
  function setMenu(open: boolean, returnFocus = false) {
    navigation.classList.toggle("is-open", open);
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute(
      "aria-label",
      (open ? toggle.dataset.closeLabel : toggle.dataset.openLabel) ?? "Menu",
    );
    if (returnFocus) toggle.focus();
  }
  function syncMenu() {
    toggle.hidden = !mobile.matches;
    setMenu(false);
  }
  mobile.addEventListener("change", syncMenu);
  toggle.addEventListener("click", () =>
    setMenu(toggle.getAttribute("aria-expanded") !== "true"),
  );
  navigation.addEventListener("click", (event) => {
    if (
      event.target instanceof Element &&
      event.target.closest("a") &&
      mobile.matches
    )
      setMenu(false, true);
  });
  document.addEventListener("keydown", (event) => {
    if (
      event.key === "Escape" &&
      toggle.getAttribute("aria-expanded") === "true"
    )
      setMenu(false, true);
  });
  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Node) || !header.contains(event.target))
      setMenu(false);
  });
  header.dataset.enhanced = "true";
  syncMenu();
</script>}
