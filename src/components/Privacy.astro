---
import { localePath } from "../i18n/paths.ts";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "./Header.astro";
import RichText from "./RichText.astro";
import { getCopy } from "../i18n/index.ts";
import type { Locale } from "../types.ts";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = getCopy(locale);
const content = copy.privacy;
---

<BaseLayout locale={locale} page="privacy">
  <Header slot="header" locale={locale} page="privacy" compact />
  <main id="main-content" class="privacy-page container section">
    <p class="eyebrow">{content.eyebrow}</p>
    <h1>{content.title}</h1>
    <p>{content.updated}</p>
    {content.authority && (
      <p class="privacy-authority">
        <strong>{content.authority}</strong>{" "}
        <a href="/privacy.html" hreflang="it">
          Italiano
        </a>
        .
      </p>
    )}
    <p>{content.intro}</p>
    {Object.entries(content.sections).map(([id, section]) => (
      <section aria-labelledby={id}>
        <h2 id={id}>{section.title}</h2>
        {section.blocks.map((block) =>
          block.kind === "paragraph" ? (
            <p>
              <RichText content={block.content} />
            </p>
          ) : (
            <dl class="privacy-storage">
              {block.items.map(({ term, description }) => (
                <div>
                  <dt>
                    <RichText content={term} />
                  </dt>
                  <dd>
                    <RichText content={description} />
                  </dd>
                </div>
              ))}
            </dl>
          ),
        )}
      </section>
    ))}
  </main>
  <footer class="site-footer">
    <div class="container footer-bottom">
      <a href={localePath(locale)}>{content.back}</a>
      <button
        type="button"
        id="analytics-settings"
        class="cookie-settings"
        hidden
      >
        {copy.common.settings}
      </button>
    </div>
  </footer>
  <script>
    import "../privacy.ts";
  </script>
</BaseLayout>
