---
interface Props {
  href: string;
  label: string;
  icon: "email" | "whatsapp";
}

const { href, label, icon } = Astro.props;
---

<a class="contact-method" href={href}>
  {icon === "whatsapp" ? (
    <img
      class="contact-method-icon"
      src="/icons/whatsapp.svg"
      width="24"
      height="24"
      alt=""
      aria-hidden="true"
    />
  ) : (
    <svg
      class="contact-method-icon"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
    >
      <rect x="3" y="5" width="18" height="14" rx="1" />
      <path d="m3 6 9 7 9-7" />
    </svg>
  )}
  <span class="contact-method-label">{label}</span>
  <span class="contact-method-arrow" aria-hidden="true">
    ↗
  </span>
</a>
