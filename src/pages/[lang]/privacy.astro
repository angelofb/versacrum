---
import Privacy from "../../components/Privacy.astro";
import { translatedLocales, isLocale } from "../../i18n/config.ts";
export function getStaticPaths() {
  return translatedLocales.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang;
if (!isLocale(lang)) throw new Error("Unknown locale");
---

<Privacy locale={lang} />
