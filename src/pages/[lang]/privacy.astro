---
import Privacy from "../../components/Privacy.astro";
import type { Locale } from "../../types.ts";
export function getStaticPaths() {
  return ["en", "fr", "es", "de"].map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Exclude<Locale, "it">;
---
<Privacy locale={lang} />
