{
  "name": "ver-sacrum",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Ver Sacrum — dimora nel centro storico di Ascoli Piceno",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --experimental-strip-types scripts/images.ts && ASTRO_TELEMETRY_DISABLED=1 astro dev --host 127.0.0.1",
    "build": "node --experimental-strip-types scripts/images.ts && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "node --experimental-strip-types scripts/serve.ts --host 127.0.0.1",
    "test": "npm run check && npm run test:seo && playwright test",
    "test:seo": "node --experimental-strip-types --test tests/seo.unit.ts",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "format": "prettier --write \"src/**/*.{astro,css,ts,json}\" \"scripts/*.ts\" \"tests/*.ts\" \"*.ts\" \"*.json\" README.md SEO.md TODO.md \".github/**/*.{yml,json}\"",
    "format:check": "prettier --check \"src/**/*.{astro,css,ts,json}\" \"scripts/*.ts\" \"tests/*.ts\" \"*.ts\" \"*.json\" README.md SEO.md TODO.md \".github/**/*.{yml,json}\""
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "astro": "^7.3.3",
    "prettier": "^3.9.8",
    "prettier-plugin-astro": "^1.0.1",
    "sharp": "^0.35.4",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/manrope": "^5.3.0"
  }
}
