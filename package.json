{
  "name": "ver-sacrum",
  "version": "2.0.1",
  "private": true,
  "type": "module",
  "description": "Ver Sacrum — dimora nel centro storico di Ascoli Piceno",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "images": "node --experimental-strip-types scripts/images.ts",
    "dev": "npm run images && ASTRO_TELEMETRY_DISABLED=1 astro dev --host 127.0.0.1",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --ignore-lock --host 127.0.0.1",
    "test": "npm run check && npm run test:seo && npm run test:images && npm run test:deploy && playwright test",
    "test:seo": "node --experimental-strip-types --test tests/seo.unit.ts",
    "test:images": "node --experimental-strip-types --test tests/images.unit.ts",
    "test:deploy": "node --experimental-strip-types --test tests/deploy.unit.ts",
    "deploy": "node --experimental-strip-types scripts/deploy.ts",
    "audit:headers": "node --experimental-strip-types scripts/audit-headers.ts",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "browsers:install": "playwright install chromium webkit",
    "hooks:install": "mise exec -- lefthook install",
    "verify": "npm run format:check && mise exec -- actionlint && npm run build && CI=true npm test && npm_config_allow_scripts= npm audit --audit-level=high"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "astro": "^7.3.3",
    "prettier": "^3.9.8",
    "prettier-plugin-astro": "^1.0.1",
    "sharp": "^0.35.4",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/manrope": "^5.3.0"
  }
}
